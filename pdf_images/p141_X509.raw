	µ "ÿהוÿץפְִֵֽ׳ֿחסנכךרםירנכסטטזכןנחםםטלןכלנכלנכלנךכןךכןלםסמןף־ֿ׃־ֿ׃פץשלםסכלנגדחוזךוזךלםןלםןלםןלםןלםןלםןלםןלםןלםןלםןלםןלםןלםןלםןלםןלםןםםןככםםםןףףץקקשץץקסעפעףץלםןדהזחכלכןנהטיךמןכססÙßßיםניםנטלןזךםזךםטלןםספסץרלנףיםנמעץפרûמעץבוטבוטםספצקû״ÙÝהוי‏ÿÿךכןßאהףפרÛÜאזחכןנפÛÜאןנפדהטןנפלםסךמסגזיßדזךמסûÿÿיםנגזירüÿנפקךמסךמסךמסךמסךמסךמסךמסךמסלםסלםסלםסלםסלםסלםסלםסלםסלםסלםסלםסלםסלםסלםסלםסךמסךמןךמןךמןךמןךמסךמסךמסךמסזימזימ°³¸םנץמסרהחמהחמטכעםנשפקÿגומוחףעפÿכםשטךקהזףלמûםן‏זטקםמÿü‎ÿנסÿאבץוך‎ÚוקםüÿטרÿÜישחףÿעûÿזמûÙßככןתםנשננרמםעכימטזיךויךטכיטםיךמכלנםמעכלנ¾¿ֳװױÙןנפתûÿךכןיךמÝÞגםמעהוינסץמןףטיםגדחםמעדהטדהטתûÿףפרßאהסעצןנפÙÚÞעףקעףקנסץ׳״Üלםסרק‎גבחןמפÿ‏ÿחזלדגט‎‏ÿזחלכלנכלנמעץטלןכןעחכמ´¹¼עקתוךמהיםגחכגחכזךםךמסמעץסץרזחידהזחחחםםםמממךךךייילללûüÿלםסדהטטיםכלנחטלוזךחטלאבוךכןתûÿגדחלםספץשֿ׀װ׳״ÚנעסחיטבגההוחמןףףפרמןפחטםצקüßאוהויחטלםמנלםןÝßÞחיטוזךדהט״ÙÝלםסחטלףפרזחכטיםעףקםמעיךמףפרûüÿךכןאבוןףצחךןלסץןףצכןעÞגומעץפץק÷»½מןסכלמךךךכככמממננננננננעיךןÜÜהככףץצûגדחאבוןנעמנןסףעיךלחטלכלנכלסיךןללפפפüןמפהדטוזךףפרףפרחטלוזךנסץְֱֶÞßהדזכÛÞדדזכנףרךםעאדטחטלü‎ÿÜÝבÜÝבשüÿטכנ״Ûאטכנדזכבהיהחלוטםךכןחטלםמעעףקדהיעףראבזßאוכלסחטםךכנךכנדהטיךמסעצץצתךכןפץשסעצ³´¸זחכךכןיךמהוידהטיךממןףנסץעףק׃װ״יךמ‎‏ÿÝÞגÙÚÞסעצכלנעץתילסעץתזימÜßהלןפמןףחטלטיםהויהוי‏ÿÿבגזםמעיטםְֳָׂÙדûÿÿÿתצÿפםÿßÜ¸ז
